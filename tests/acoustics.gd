extends SceneTree
var game
var failures=0
func _initialize() -> void:
	root.set_meta("test_session",true); root.set_meta("cinematic",true); call_deferred("run")
func check(ok: bool,label: String) -> void:
	if ok: print("PASS: ",label)
	else: failures+=1; push_error(label)
func frames(n: int) -> void:
	for i in range(n): await physics_frame
func settle_mix(sound) -> void:
	for i in range(4): sound.refresh_occlusion()
	sound.update_spatial_mix(0.5,true)
func run() -> void:
	game=load("res://scenes/main.tscn").instantiate(); root.add_child(game); await process_frame; await physics_frame; game.launch(); game.player.set_physics_process(false)
	for d in game.drones: d.set_physics_process(false); d.position=Vector3(1000+d.spawn_id*4,1000,1000)
	for f in game.systems.foundries: f.set_physics_process(false)
	var p=game.player; p.position=Vector3(0,1,-44); p.rotation=Vector3.ZERO; p.update_view(0); await frames(2)
	var s=game.sound; var voice=s.play_at("machine",Vector3(0,1,-51),0.3,true)
	check(voice.bus=="Ambience" and voice.get_meta("occlusion")==0,"A clear positional source begins on its original full-bandwidth bus")
	var wall=game.Forge.box(game,Vector3(0,1,-48),Vector3(4,4,0.3),Color.GRAY,0,true); await frames(2); settle_mix(s)
	check(voice.bus=="Muffled_Ambience" and voice.volume_db<float(voice.get_meta("dry_db"))-13,"A real intervening wall lowers and filters the positional source")
	var bus=AudioServer.get_bus_index("Muffled_Ambience"); var filter=AudioServer.get_bus_effect(bus,0)
	check(AudioServer.get_bus_send(bus)=="Ambience" and filter is AudioEffectLowPassFilter and filter.cutoff_hz==1800,"Muffled sources pass through a real low-pass filter into the original effects mix")
	voice.position=Vector3(-5,1,-51); await frames(2); settle_mix(s)
	check(voice.bus=="Ambience" and voice.volume_db>float(voice.get_meta("dry_db"))-0.2,"Clear sight around the obstruction restores the original source level and bus")
	voice.position=Vector3(0,1,-51); await frames(2); settle_mix(s)
	s.effects_volume=0.5; s._process(0.01)
	check(AudioServer.get_bus_volume_db(AudioServer.get_bus_index("Ambience"))<-6 and AudioServer.get_bus_volume_db(bus)==0,"Muffled audio still respects the saved effects-volume control without double attenuation")
	var cues=s.play_at("pickup",Vector3(0,1,-51),0.1)
	check(cues.bus=="Interface" and cues.volume_db==cues.get_meta("dry_db"),"Interface and pickup cues stay clear even behind an obstruction")
	var checks=s.occlusion_checks; game.state="paused"; voice.position=Vector3(-5,1,-51); s._process(0.3)
	check(s.occlusion_checks==checks and voice.stream_paused,"Paused audio does not continue occlusion ray casts or machinery playback")
	game.state="playing"; await frames(2); settle_mix(s)
	check(voice.bus=="Ambience","Resuming updates the source for its current unobstructed position")
	for i in range(14): s.play_at("machine",Vector3(2,1,-50-i*0.1),0.02,true)
	checks=s.occlusion_checks; s.refresh_occlusion()
	check(s.occlusion_checks-checks<=8,"Each ongoing occlusion refresh performs at most eight source ray casts")
	game.hit_confirm=0; game.fire_laser()
	check(game.hit_feedback.last_surface=="metal" and game.hit_confirm==0,"A real pulse wall strike gives metallic feedback without a false damage confirmation")
	var sounds=get_nodes_in_group("spatial_audio").filter(func(v): return v.get_meta("surface","")=="metal")
	check(not sounds.is_empty(),"Wall strikes now create an actual positional impact voice")
	var glass=game.level.find_children("*","StaticBody3D",true,false).filter(func(b): return b.get_meta("surface","")=="glass")
	check(glass.size()>0,"Observation-glass collision keeps its surface identity after static batching")
	p.position=Vector3(0,44,-99); p.rotation=Vector3.ZERO; p.update_view(0); await frames(2); game.fire_laser()
	check(game.hit_feedback.last_surface=="glass" and glass[0].collision_layer==1,"Shooting a real observation window produces glass feedback and leaves its collision intact")
	wall.queue_free(); p.position=Vector3(0,1,-44); p.rotation=Vector3.ZERO; p.update_view(0)
	var armored=game.spawn_drone(Vector3(0,1,-51),"bulwark"); armored.set_physics_process(false); armored.visual.look_at(p.position); await frames(2); game.fire_laser()
	check(game.hit_feedback.last_surface=="armor" and armored.health<150 and armored.health>140,"A frontal pulse hit gives armor feedback and retains the existing armor reduction")
	game.arsenal.fire_rail(1)
	check(get_nodes_in_group("spatial_audio").any(func(v): return v.get_meta("surface","")=="shield" and v.position.distance_to(armored.position)<2) and armored.health<50,"Rail fire bypasses frontal armor and uses the intact shield contact feedback")
	p.position=armored.position+Vector3(4,0,0); p.look_at(armored.position); p.update_view(0); await frames(2); game.fire_laser()
	check(game.hit_feedback.last_surface=="hull" and armored.health>0,"A flanking hit on a damaged craft gives hull feedback")
	var f=game.systems.foundries[0]; p.position=f.position+Vector3(0,0,4); p.look_at(f.position); p.update_view(0); await frames(2); game.fire_laser()
	check(game.hit_feedback.last_surface=="metal" and f.health<180,"Robot foundry chassis use mechanical impact feedback")
	var before=get_nodes_in_group("spatial_audio").filter(func(v): return v.get_meta("surface","")=="metal").size()
	for i in range(3): game.fire_laser()
	var after=get_nodes_in_group("spatial_audio").filter(func(v): return v.get_meta("surface","")=="metal").size()
	check(after<=before+1,"Simultaneous impact contacts do not flood the mix with duplicate thuds")
	game.queue_free(); await process_frame; await process_frame; await create_timer(0.2,true,false,true).timeout
	print("ACOUSTICS TEST COMPLETE: ",failures," failures"); quit(1 if failures else 0)
